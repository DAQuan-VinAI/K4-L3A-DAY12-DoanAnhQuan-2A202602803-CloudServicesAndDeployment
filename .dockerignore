# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Git
.git
.gitignore
.github

# Python / môi trường ảo
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần lúc chạy
tests
screenshots
*.md
*.log
.DS_Store
.idea
.vscode
docker-compose.yml
Dockerfile
.dockerignore
